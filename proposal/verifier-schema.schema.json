{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verifier verdict object",
  "type": "object",
  "required": ["verdict", "reason", "evidence", "observed_at", "checked_at", "untested"],
  "properties": {
    "verdict": { "type": "string", "enum": ["true", "false", "inconclusive"] },
    "reason": {
      "type": "string",
      "enum": [
        "settled-under-terms", "probe-ok", "no-domain", "wrong-domain",
        "mapping-unknown", "mapping-stale", "terms-mismatch",
        "probe-unreachable", "digest-unbound", "self-referential"
      ]
    },
    "evidence": { "type": "string", "enum": ["none", "terms", "probe", "purchase"] },
    "detail": {
      "type": "object",
      "description": "Optional machine-readable companion to reason, for codes that reference a specific mismatched field.",
      "properties": {
        "field": { "type": "string" },
        "expected": { "type": "string" },
        "got": { "type": "string" }
      }
    },
    "accepts_index": {
      "type": "integer",
      "description": "Index into the challenge's accepts array that this verdict, digest, and mapping apply to. Required whenever the resolved challenge carries more than one accept."
    },
    "attestation": {
      "type": "object",
      "description": "A signed record the verifier publishes at a location independent of any resource operator's domain, so a client can check the verifier's independence claim against a published artifact rather than a bare declaration.",
      "properties": {
        "key_url": { "type": "string", "format": "uri" },
        "record_url": { "type": "string", "format": "uri" },
        "signed": { "type": "boolean" }
      }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "checked_at": { "type": "string", "format": "date-time" },
    "untested": {
      "type": "array",
      "items": { "type": "string", "enum": ["terms", "probe", "purchase"] }
    },
    "digest": {
      "type": "object",
      "required": ["scheme", "network", "asset", "payTo", "amount", "extra"],
      "properties": {
        "scheme": { "type": "string" },
        "network": { "type": "string" },
        "asset": { "type": "string" },
        "payTo": { "type": "string" },
        "amount": { "type": "string" },
        "extra": { "type": "object" }
      }
    },
    "mapping": {
      "type": "object",
      "properties": {
        "entry": { "type": "string" },
        "contract": { "type": "string" },
        "read_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
